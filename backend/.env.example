# ==================== 服务地址 ====================
# Ollama（本地 LLM 服务）
OLLAMA_URL=http://localhost:11434
# 主模型（必填）
OLLAMA_MODEL=qwen3:32b
# 备用模型（逗号分隔，主模型不可用时按顺序降级）
OLLAMA_FALLBACK_MODELS=qwen3:32b,qwen2.5:14b,qwen2.5:7b
# ComfyUI（文生图 + 修图）
COMFYUI_URL=http://127.0.0.1:8188

# ==================== 服务器 ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ==================== 并发与限流 ====================
# ComfyUI 同时执行的最大任务数（建议不超过 2，避免显存溢出）
MAX_CONCURRENT_TASKS=2
# 每用户每分钟请求上限
RATE_LIMIT_PER_MINUTE=30
# 每用户每小时出图任务上限（出图耗资源）
RATE_LIMIT_GENERATE_PER_HOUR=20

# ==================== 重试 ====================
LLM_MAX_RETRIES=2
COMFYUI_MAX_RETRIES=2

# ==================== 认证 ====================
# JWT 密钥（生产环境务必修改）
JWT_SECRET=change_me_in_production
# JWT 过期时间（小时）
JWT_EXPIRE_HOURS=24

# ==================== 工作流文件（可选，默认在项目根）====================
# T2I_WORKFLOW=FLUX(文生图）-短剧项目-API-agent(test).json
# EDIT_WORKFLOW=服装迁移-千问Edit2509图像编辑 (2)-API-agent-test.json

# ==================== 输出目录（可选）====================
# OUTPUT_DIR=output
